{
  "name": "@bowerbirdjs/agent",
  "version": "0.0.0",
  "description": "Agent-facing tool definitions for editing Bowerbird documents.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bowerbirdjs/bowerbird.git",
    "directory": "packages/agent"
  },
  "dependencies": {
    "@bowerbirdjs/core": "workspace:*",
    "@bowerbirdjs/import": "workspace:*",
    "@bowerbirdjs/layout": "workspace:*",
    "zod": "^4.6.7"
  }
}
