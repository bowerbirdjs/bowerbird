{
  "id": "import-html-block",
  "category": "build",
  "start": "saas-landing",
  "prompt": "A colleague wrote this block of HTML. Add it to the home page directly after the hero as editable content, keeping its texts exactly as they are:\n\n<section><h2>Why teams switch</h2><ul><li><h3>Before</h3><p>Spreadsheets, guesses and late invoices.</p></li><li><h3>After</h3><p>Every hour logged and billed.</p></li></ul></section>",
  "checks": [
    {
      "type": "pageChildren",
      "page": "home",
      "kinds": ["nav", "hero", "box", "features", "pricing", "footer"]
    },
    {
      "type": "find",
      "query": {
        "page": "home",
        "type": "text",
        "props": {
          "tag": "h2",
          "text": "Why teams switch"
        }
      },
      "count": {
        "equals": 1
      }
    },
    {
      "type": "find",
      "query": {
        "page": "home",
        "type": "text",
        "props": {
          "tag": "h3",
          "text": "Before"
        }
      },
      "count": {
        "equals": 1
      }
    },
    {
      "type": "find",
      "query": {
        "page": "home",
        "props": {
          "text": "Spreadsheets, guesses and late invoices."
        }
      },
      "count": {
        "equals": 1
      }
    },
    {
      "type": "find",
      "query": {
        "page": "home",
        "props": {
          "text": "Every hour logged and billed."
        }
      },
      "count": {
        "equals": 1
      }
    },
    {
      "type": "unchangedExcept",
      "ids": [],
      "allow": ["created"]
    }
  ]
}
