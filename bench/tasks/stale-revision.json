      "value": "Start free"
    },
    {
      "type": "propEquals",
      "id": "hero-1/heading",
      "prop": "text",
      "value": "Hours in, invoices out"
    },
    {
      "type": "unchangedExcept",
      "ids": ["hero-1/primary", "hero-1/heading"]
