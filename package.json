{
  "name": "bowerbird-monorepo",
  "private": true,
  "type": "module",
  "description": "Bowerbird: an open-source visual page editor that humans and AI agents edit together.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/*/tsconfig.json bench/tsconfig.json",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "typecheck": "tsc -b packages/*/tsconfig.json bench/tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "mcp": "node packages/mcp/dist/cli.js",
    "changeset": "changeset",
    "bench": "node bench/dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0",
    "vite": "^8.3.8"
  }
}
